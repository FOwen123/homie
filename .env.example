# Copy to .env (git-ignored) and fill in. Never commit .env.

# Meta Model API: Muse Spark (labels, style, planner) + SAM 3.1 (object outlines) + Muse Image (photo edits).
# Get it at https://dev.meta.ai → API keys. Needed now for the SAM + Muse measurement test.
META_MODEL_API_KEY=

# Apify: Shopee Taiwan product scraper (memo23/shopee-scraper). Free plan, no card.
# Get it at https://console.apify.com/settings/integrations. Used for catalog imports and the Modal live-search worker; include it in Modal secret "homie".
APIFY_TOKEN=

# Modal: GPU host for MapAnything (Meta's 3D model). Needed tomorrow, once your card works.
# Create at https://modal.com/settings/tokens (or run `modal token new`).
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# Shared secret between the Pages function /api/upload and the processing server (pipeline/server.ts). Any random string.
ROOMIE_UPLOAD_TOKEN=
